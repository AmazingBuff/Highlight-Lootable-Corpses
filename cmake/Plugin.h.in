#pragma once

#include <string_view>

#define PLUGIN_NAMESPACE Amazing::@PROJECT_NAME@
#define PLUGIN_NAMESPACE_BEGIN namespace Amazing { namespace @PROJECT_NAME@ {
#define PLUGIN_NAMESPACE_END } }

namespace Plugin
{
	inline constexpr REL::Version Plugin_Version
	{
		@PROJECT_VERSION_MAJOR@u,
		@PROJECT_VERSION_MINOR@u,
		@PROJECT_VERSION_PATCH@u,
	};

	inline constexpr std::string_view Plugin_Name = "@PROJECT_NAME@"sv;
	inline constexpr std::string_view Plugin_Author = "AmazingBuff";
}
